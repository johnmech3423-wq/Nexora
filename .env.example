# ============================================================
# Nexora — environment variables
# Copy to .env.local for development. Never commit real secrets.
# Every value is read server-side unless prefixed NEXT_PUBLIC_.
# ============================================================

# --- Core -----------------------------------------------------
# MongoDB connection string (MongoDB Atlas recommended for prod)
DATABASE_URL=mongodb://127.0.0.1:27017/nexora

# Public origin of the app (used for links, emails, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session signing secret. Generate: openssl rand -base64 48
AUTH_SECRET=

# --- Email (verification, invites, notifications) -------------
# Built-in mailer prints to server logs / files a JSON "outbox"
# when SMTP is not configured — safe for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nexora <no-reply@nexora.app>"

# --- File storage ---------------------------------------------
# local  = files stored under ./storage (development default)
# cloudinary = production-ready object storage
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI assistant (optional; app runs fully without it) -------
AI_PROVIDER=none            # none | openai | anthropic | openai-compatible
AI_API_KEY=
AI_BASE_URL=               # for openai-compatible endpoints (e.g. LM Studio, Ollama proxy)
AI_MODEL=
AI_MAX_REQUESTS_PER_MEMBER_PER_DAY=30

# --- Realtime (optional; app degrades to polling when unset) --
# Any Pusher-compatible endpoint works (e.g. pusher.com, soketi).
REALTIME_DRIVER=none        # none | pusher
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
# Publicly readable key used by the browser (same as PUSHER_KEY for Pusher)
NEXT_PUBLIC_REALTIME_KEY=
NEXT_PUBLIC_REALTIME_CLUSTER=

# --- Billing ----------------------------------------------------
# Abstracted provider — UI gates features by plan regardless of this value.
BILLING_PROVIDER=none       # none | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Webhook delivery -------------------------------------------
# Secret used to sign Nexora's outgoing webhooks (HMAC-SHA256).
WEBHOOK_SECRET=

# --- Google OAuth (optional) ------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# --- GitHub OAuth (optional) ------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
